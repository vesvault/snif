# Build output
*.o
*.lo
*.la
*.a
*.so
*.so.*
.libs/
.deps/
# Built executables, anchored to their paths so the bare names do not also
# match the snifd/ source directory (which would hide new files like man pages).
/snifd/snifd
/snif

# Autotools generated artifacts (regenerated by `autoreconf -fi`)
/autom4te.cache/
/config.h
/config.log
/config.status
/stamp-h1
/libtool
*~

# Distribution tarballs
*.tar.gz
*.tar.xz
