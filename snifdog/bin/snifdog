 \e[1m|\e[0m \e[2;33m|     |\e[0m \e[1m\\__\e[0m\e[1;30m|\e[0m\e[1m_____\e[0m\e[1;30m/  o\\\e[0m        e2e TLS CA Proxy
 \e[1m|\e[0m \e[2;33m|     |\e[0m  \e[1;30m``/`````\\___/\e[0m
 \e[1m|\e[0m \e[2;33m|     |\e[0m \e[1;30m. |\e[0m <\e[1m"""""""\e[0m\e[1;31m~~\e[0m        https://snif.host
 \e[1m|\e[0m  \e[2;33m\\___/\e[0m \e[1;30m``  \\\e[0m\e[1m________/\e[0m         (C) 2021-2026 VESvault Corp
  \e[1m\\\e[0m  \e[2;33m'''\e[0m  \e[1;30m```\e[0m \e[1m/\e[0m\e[1;30m````````\e[0m          \e[1msnifdog\e[0m v.$VERSION
   \e[1m\\_________/\e[0m

BANNER

# Write $str to $fh, stripping the ANSI SGR escapes when $fh is not a terminal
# (piped, redirected, captured to a log) -- the Perl analogue of snifd's
# snif_out_ansi: colored on a tty, clean plain text everywhere else.
sub out_ansi {
    my ($fh, $str) = @_;
    $str =~ s/\e\[[0-9;]*m//g unless -t $fh;
    print {$fh} $str;
}

#___________________________________________________________________ commands (usage)

sub usage {
    my $fh = shift || \*STDOUT;
    out_ansi($fh, $BANNER);
    print {$fh} <<"EOF";
snifdog $VERSION -- the SNIF CA Transparency watchdog

usage:
  snifdog pin <name> [--from <cert>] [--spki <hex>] [--issuer <s>]
                          anchor a name's SPKI (explicit pin, strongest anchor)
  snifdog poll            one incremental CT pass (cron */15); exit 2 on alert
  snifdog watch           long-running loop (poll every SNIFDOG_POLL_INTERVAL s)
  snifdog list            show the pin database
  snifdog help            this text

config: $DEFAULT_CONF   (override with \$SNIFDOG_CONF)
EOF
    return 0;
}

#___________________________________________________________________ main

sub main {
    my $cmd = shift @ARGV // 'help';
    load_conf($DEFAULT_CONF);
    openlog('snifdog', 'pid', LOG_DAEMON) if use_syslog();

    my $rc = 0;
    if    ($cmd eq 'pin')  { $rc = cmd_pin(@ARGV) }
    elsif ($cmd eq 'poll') { $rc = run_pass() }
    elsif ($cmd eq 'list') { $rc = cmd_list() }
    elsif ($cmd eq 'watch') {
	say_log('INFO', "snifdog watch: interval=$C{interval}s");
	while (1) {
	    $NewAlerts = 0;
	    eval { run_pass(); 1 } or say_log('ERROR', "pass: $@");
	    sleep $C{interval};
	}
    }
    elsif ($cmd eq 'help' || $cmd eq '-h' || $cmd eq '--help') { $rc = usage() }
    else { print STDERR "snifdog: unknown command '$cmd'\n\n"; usage(\*STDERR); $rc = 64 }

    closelog() if use_syslog();
    return $rc;
}

# Run as a program; stay quietly require-able (modulino) for tests, which pull in
# these subs and drive process_cert() directly without a live CT fetch.
exit main() unless caller;
1;
