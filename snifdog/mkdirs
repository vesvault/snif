# Create the runtime directories snifdog uses for its pin database, source
# cursor, and evidence bundles. Resolve the base dir from the snifdog conf
# (SNIFDOG_DIR); fall back to this script's own directory.

[ -r /etc/snif/snifdog.conf ] && . /etc/snif/snifdog.conf
SNIFDOG_DIR="${SNIFDOG_DIR:-$(dirname "$0")}"

mkdir -m 02775 "$SNIFDOG_DIR/pins"
mkdir -m 02755 "$SNIFDOG_DIR/var"
mkdir -m 02755 "$SNIFDOG_DIR/evidence"
