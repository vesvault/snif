<?xml version="1.0"?>
<!-- Psalm's taint analysis of the CA proxy's PHP: run.sh, README. -->
<psalm
    errorLevel="4"
    resolveFromConfigFile="true"
    findUnusedCode="false"
    findUnusedBaselineEntry="true"
    phpVersion="8.4"
    errorBaseline="psalm-baseline.xml"
    autoloader="autoload.php"
>
    <projectFiles>
        <directory name="../../public_html"/>
        <directory name="../../secure_html"/>
        <directory name="../../inc"/>
    </projectFiles>
    <plugins>
        <plugin filename="SnifTaintSources.php"/>
    </plugins>
</psalm>
