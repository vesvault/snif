[Unit]
Description=SNIF Relay
# snifd binds every address its -s name resolves to, and does not start if a bind fails.
After=network-online.target
Wants=network-online.target

[Service]
# snifd faces the internet, so it runs as snifd, which has read-only access:
# group snif reads /etc/snif/snif.conf, and snifd owns only its own pipes
# (ca-proxy/mkdirs). The CA proxy's keys and tree are snif's.
User=snifd
Group=snif
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
LimitNOFILE=1048576
ExecStart=/usr/bin/snif-relay
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
