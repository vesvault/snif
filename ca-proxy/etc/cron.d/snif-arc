# snif-arc -- archive the SNIF certificates older than 75 days, so that
# snif-certd issues a fresh one the next time the connector asks, and apply
# the retention periods set in snif.conf (ca-proxy/README). It runs on every
# relay node; a run with nothing to do changes nothing. For a host without
# systemd: `make install-cron` in ca-proxy puts it in /etc/cron.d where
# absent. Use it instead of snif-arc.timer, not alongside it.

MAILTO=root

17 4 * * *  snif  /usr/bin/snif-arc
