# Create the runtime directories and control pipes the SNIF CA proxy daemons
# and scripts expect. What exists is left as it is, so it can run again, for
# example after SNIF_CLUSTER_PEERS changes.
#
#   mkdirs [base-dir]
#
# The base dir is the argument, else SNIF_CA_PROXY from /etc/snif/snif.conf
# (the same one the daemons read), else this script's own directory.
# The daemons run as snif and own their pipes: run as root, it gives what it
# creates to snif; otherwise run it as snif.

BASE=$1
for f in /etc/snif/snif.conf /etc/snif.conf; do
    if [ -r $f ]; then . $f; break; fi
done
SNIF_DIR="${BASE:-${SNIF_CA_PROXY:-$(dirname "$0")}}"

own() {
    if [ "$(id -u)" = 0 ] && id -u snif >/dev/null 2>&1; then chown snif:snif "$1"; fi
}
mkd() {	# mkd <mode> <dir>
    [ -d "$SNIF_DIR/$2" ] || { mkdir -m $1 "$SNIF_DIR/$2" && own "$SNIF_DIR/$2"; }
}
mkp() {	# mkp <mode> <fifo>
    [ -p "$SNIF_DIR/$2" ] || { mkfifo -m $1 "$SNIF_DIR/$2" && own "$SNIF_DIR/$2"; }
}

mkd 02775 crt
mkd 02775 csr
mkd 02775 cfg
mkd 02775 auth
mkd 02755 arc
mkd 02755 var
mkd 02775 apns
mkd 02775 log
mkd 02775 sync-queue

mkp 0620 var/snif-certd.ctl
mkp 0620 var/snifd-in.ctl
mkp 0640 var/snifd-out-apnsd.ctl

# A relay cluster node (doc/cluster.md): a FIFO pair and a queue per peer.
for p in $SNIF_CLUSTER_PEERS; do
    n=${p%%=*}
    mkp 0620 var/snifd-out-peer-$n.ctl
    mkp 0620 var/snifd-in-peer-$n.ctl
    mkd 02775 sync-queue/$n
done
